
:root {
  --radius: 22px;
  --radius-sm: 16px;
  --shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
  --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.12);
  --transition: 180ms ease;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  color-scheme: dark;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  transition: background-color var(--transition), color var(--transition);
}

button,
input {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

html[data-theme='dark'] {
  color-scheme: dark;
  --bg: radial-gradient(circle at top left, rgba(14, 165, 233, 0.14), transparent 34%),
    radial-gradient(circle at top right, rgba(99, 102, 241, 0.18), transparent 28%),
    linear-gradient(180deg, #07111f 0%, #0f172a 48%, #111827 100%);
  --surface: rgba(15, 23, 42, 0.84);
  --surface-soft: rgba(30, 41, 59, 0.74);
  --border: rgba(148, 163, 184, 0.16);
  --text: #f8fafc;
  --text-soft: #cbd5e1;
  --accent: #38bdf8;
  --shadow: 0 18px 50px rgba(2, 8, 23, 0.42);
}

html[data-theme='light'] {
  color-scheme: light;
  --bg: radial-gradient(circle at top left, rgba(56, 189, 248, 0.12), transparent 32%),
    radial-gradient(circle at top right, rgba(99, 102, 241, 0.1), transparent 30%),
    linear-gradient(180deg, #eef7ff 0%, #f8fafc 52%, #ffffff 100%);
  --surface: rgba(255, 255, 255, 0.94);
  --surface-soft: rgba(248, 250, 252, 0.96);
  --border: rgba(15, 23, 42, 0.08);
  --text: #0f172a;
  --text-soft: #475569;
  --accent: #0284c7;
  --shadow: 0 18px 44px rgba(15, 23, 42, 0.1);
}

body {
  background: var(--bg);
  color: var(--text);
}

#root {
  min-height: 100vh;
}

.weather-app {
  width: min(1480px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 36px;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
}

.eyebrow {
  display: inline-flex;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.78rem;
  margin-bottom: 12px;
}

h1,
h2,
p {
  margin: 0;
}

h1 {
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 0.97;
}

.hero-copy,
.section-header p,
.label,
.location-row span,
.forecast-rain,
.hour-meta {
  color: var(--text-soft);
}

.hero-copy {
  margin-top: 12px;
  max-width: 64ch;
  line-height: 1.55;
}

.hero-actions,
.search-section {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.theme-toggle,
.primary-button,
.search-box,
.segmented-control,
.location-row,
.recent-chip {
  box-shadow: var(--shadow);
}

.theme-toggle,
.primary-button,
.recent-chip {
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  padding: 12px 16px;
  cursor: pointer;
}

.segmented-control {
  display: inline-flex;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--surface);
  padding: 4px;
}

.segmented-control button {
  border: none;
  background: transparent;
  color: var(--text-soft);
  border-radius: 999px;
  padding: 10px 14px;
  cursor: pointer;
}

.segmented-control .active {
  background: var(--surface-soft);
  color: var(--text);
}

.search-section {
  margin: 18px 0;
}

.search-box {
  flex: 1;
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 18px;
  padding: 0 16px;
}

.search-box input {
  width: 100%;
  min-height: 52px;
  border: none;
  outline: none;
  background: transparent;
  color: var(--text);
}

.primary-button {
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.95), rgba(59, 130, 246, 0.95));
  color: white;
  border: none;
}

.main-grid {
  display: grid;
  grid-template-columns: minmax(300px, 360px) minmax(0, 1fr);
  gap: 18px;
}

.content-col,
.sidebar {
  display: grid;
  gap: 18px;
  align-content: start;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 18px;
  backdrop-filter: blur(14px);
  box-shadow: var(--shadow);
}

.section-header,
.current-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: end;
}

.location-list {
  margin-top: 16px;
  display: grid;
  gap: 10px;
  max-height: 350px;
  overflow: auto;
}

.location-row {
  border: 1px solid var(--border);
  background: var(--surface-soft);
  color: var(--text);
  border-radius: 18px;
  padding: 14px;
  text-align: left;
  display: grid;
  gap: 4px;
  cursor: pointer;
}

.location-row.active {
  border-color: rgba(56, 189, 248, 0.45);
  box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.18);
}

.recent-header {
  margin-top: 22px;
}

.recent-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 14px;
}

.current-card {
  min-height: 220px;
}

.condition-icon {
  font-size: 4rem;
  line-height: 1;
}

.current-grid {
  margin-top: 20px;
  display: grid;
  grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.temperature-block,
.metric,
.forecast-card,
.hour-card {
  border-radius: 20px;
  border: 1px solid var(--border);
  background: var(--surface-soft);
}

.temperature-block,
.metric {
  padding: 18px;
}

.temperature-block strong {
  display: block;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  line-height: 1;
}

.temperature-block span,
.metric span {
  display: block;
  margin-top: 8px;
  color: var(--text-soft);
}

.metric strong {
  display: block;
  margin-top: 10px;
  font-size: 1.4rem;
}

.forecast-grid {
  margin-top: 16px;
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12px;
}

.forecast-card {
  padding: 16px;
  text-align: center;
}

.forecast-day {
  font-weight: 700;
}

.forecast-icon {
  font-size: 2rem;
  margin: 12px 0 10px;
}

.forecast-condition {
  min-height: 40px;
  font-size: 0.95rem;
}

.forecast-temps {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 12px;
}

.hourly-grid {
  margin-top: 16px;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
}

.hour-card {
  padding: 14px;
  text-align: center;
}

.hour-time {
  font-weight: 700;
}

.hour-icon {
  font-size: 1.8rem;
  margin: 10px 0 8px;
}

.hour-temp {
  font-size: 1.35rem;
  font-weight: 700;
}

.placeholder,
.banner {
  border: 1px dashed var(--border);
  border-radius: 18px;
  padding: 16px;
  color: var(--text-soft);
  background: rgba(148, 163, 184, 0.05);
}

.large {
  margin-top: 18px;
}

.sr-only {
  position: absolute;
  left: -9999px;
}

@media (max-width: 1200px) {
  .main-grid {
    grid-template-columns: 1fr;
  }

  .forecast-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hourly-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .current-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .weather-app {
    width: min(100% - 20px, 1480px);
    padding-top: 16px;
  }

  .hero,
  .current-top,
  .section-header {
    flex-direction: column;
    align-items: stretch;
  }

  .forecast-grid,
  .hourly-grid,
  .current-grid {
    grid-template-columns: 1fr;
  }

  .search-section {
    align-items: stretch;
  }

  .primary-button {
    width: 100%;
  }
}
